# BirdNET-Go API base URL (used for common name lookups). From inside the
# container, so not localhost: with BirdNET-Go on this host and either
# compose file (`make run` or the image install), use
# http://host.docker.internal:8080 — both map it on Linux.
BIRDNET_BASE_URL=http://birdnet-go:8080

# Image install only: the published version to run (default: latest).
# Put it here, not on the command line, so `pull` and `up` agree.
# BIRDHOUSE_IMAGE_TAG=v0.1.1

# Path to BirdNET-Go's SQLite database on the *host* (used by Docker
# to mount the file into the container — not read by the app directly)
BIRDNET_DB_HOST_PATH=/path/to/birdnet-go/data/birdnet.db

# Path to the database inside the container (always /data/birdnet.db)
BIRDNET_DB_PATH=/data/birdnet.db

# BirdNET-Go's taxonomy.csv on the *host* (Docker mount source). Used to
# show birds only; BirdNET-Go also reports mammals, frogs and sound classes.
BIRDNET_TAXONOMY_HOST_PATH=/path/to/birdnet-go/config/models/shared/taxonomy.csv

# Path to the taxonomy inside the container (always /data/taxonomy.csv)
BIRDNET_TAXONOMY_PATH=/data/taxonomy.csv

# Port the app listens on inside the container. Keep 8090: the compose files
# and the healthcheck assume it.
PORT=8090

# Minimum detection confidence to display (0.0–1.0)
MIN_CONFIDENCE=0.6

# Directory for cached species photos inside the container
# (backed by the birdhouse-images Docker volume — do not change)
IMAGE_CACHE_DIR=/app/data/image-cache

# Timezone for "today" (IANA name)
TZ=America/Los_Angeles

# Seconds between background DB refreshes
POLL_INTERVAL=60

# Seconds each carousel slide is shown
SLIDE_DURATION=8

# Anthropic API key for vision-based smart photo cropping (optional).
# When set, each species' photo gets a one-time Claude vision call to find
# a crop anchor on the bird itself instead of the geometric center, cached
# to disk forever. Omit to disable — photos fall back to a center crop.
ANTHROPIC_API_KEY=

# Host directory for app.log (default ./logs).
# BIRDHOUSE_LOG_DIR=./logs
