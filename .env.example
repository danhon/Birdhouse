# BirdNET-Go API base URL (used for common name lookups)
BIRDNET_BASE_URL=http://192.168.1.100:8888

# Path to BirdNET-Go's SQLite database on the *host* (used by Docker
# to mount the file into the container — not read by the app directly)
BIRDNET_DB_HOST_PATH=/home/danhon/birdnet-go-app/data/birdnet.db

# Path to the database inside the container (always /data/birdnet.db)
BIRDNET_DB_PATH=/data/birdnet.db

# Port the app listens on inside the container
PORT=8090

# Minimum detection confidence to display (0.0–1.0)
MIN_CONFIDENCE=0.6

# Directory for cached species photos inside the container
# (backed by the birdhouse-images Docker volume — do not change)
IMAGE_CACHE_DIR=/app/data/image-cache

# Timezone for "today" (IANA name)
TZ=America/Los_Angeles

# Seconds between background DB refreshes
POLL_INTERVAL=60

# Seconds each carousel slide is shown
SLIDE_DURATION=8

# Traefik routing — set by Makefile, override here only if needed
SERVICE_HOST=birdhouse.sgc.rayandhon.com
