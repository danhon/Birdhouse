# BirdNET-Go API base URL (used for common name lookups)
BIRDNET_BASE_URL="http://192.168.1.100:8888"

# Path to BirdNET-Go's SQLite database (used for detections)
BIRDNET_DB_PATH="/home/danhon/birdnet-go-app/data/birdnet.db"

# Port Birdhouse listens on
PORT="8090"

# Minimum detection confidence to include (0.0–1.0)
MIN_CONFIDENCE="0.6"

# Directory for cached species photos (from iNaturalist)
IMAGE_CACHE_DIR="data/image-cache"

# Timezone for determining "today" (IANA timezone name)
TZ="America/Los_Angeles"

# Seconds between background data refreshes
POLL_INTERVAL="60"

# Seconds each slide is shown in the carousel
SLIDE_DURATION="8"

# Anthropic API key for vision-based smart photo cropping (optional).
# Omit to disable — photos fall back to a center crop.
ANTHROPIC_API_KEY=""
