# BirdNET-Go API base URL
BIRDNET_BASE_URL="http://192.168.1.100:8888"

# Port Birdhouse listens on
PORT="8090"

# Minimum detection confidence to include (0.0–1.0)
MIN_CONFIDENCE="0.6"

# Directory for cached species photos
IMAGE_CACHE_DIR="data/image-cache"

# Timezone for determining "today" (IANA timezone name)
TZ="America/Los_Angeles"

# Seconds between background data refreshes
POLL_INTERVAL="60"

# Seconds each slide is shown in the carousel
SLIDE_DURATION="8"
